# Install:  sudo cp stock-picker.service stock-picker.timer /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now stock-picker.timer
[Unit]
Description=Run the stock picker daily after the US market close

[Timer]
OnCalendar=*-*-* 22:30:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
