# --- OKX API key (create it under Demo Trading first!) ---
# Permissions: Read + Trade ONLY. Never enable Withdraw. Bind it to your server's IP.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO=true            # true = fake money. Set false only after the test period.
TRADING_CAPITAL=200      # bot trades as if it had only $200 (+ its own P&L). 0 = real balance.

# --- AI brain (Claude) ---
ANTHROPIC_API_KEY=
BRAIN_ENABLED=true
BRAIN_MODEL=claude-opus-5-5   # cheaper: claude-sonnet-5-5 (~half) or claude-haiku-5-5 (~40x cheaper)
BRAIN_EFFORT=high
NEWS_SCAN_HOURS=24

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
