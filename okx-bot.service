# Install:  sudo cp okx-bot.service /etc/systemd/system/ && sudo systemctl daemon-reload
#           sudo systemctl enable --now okx-bot
# Logs:     journalctl -u okx-bot -f
[Unit]
Description=OKX trend bot with AI risk brain
After=network-online.target
Wants=network-online.target

[Service]
User=bot
WorkingDirectory=/opt/claude-trade-brain
ExecStart=/opt/claude-trade-brain/.venv/bin/python -m okxbot.bot
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
